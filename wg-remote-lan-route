#!/usr/bin/env python3
"""Gate road-warrior LAN access and maintain its dedicated OMR policy routes.

The persistent flag is root-owned; absent means deny. The synchronized router
address permits only GUI HTTP(S) by default. LAN prefixes enter nftables and
routing table 24612 only while access is enabled and the OMR VPN is reachable.
"""

import argparse
import fcntl
import ipaddress
import json
import os
import re
import shlex
import socket
import sys
import subprocess
import tempfile
from pathlib import Path

CONFIG = Path("/etc/openmptcprouter-vps-admin/omr-admin-config.json")
STATE = Path("/etc/openmptcprouter-vps-admin/wg-remote-lan-access.enabled")
LOCK = Path("/etc/openmptcprouter-vps-admin/wg-remote-lan-access.lock")
NFT_RULESET = Path("/etc/nftables/omr.nft")
MQVPN_CONFIG = Path("/etc/mqvpn/server.json")
WG_INTERFACE = "client-wg0"
TABLE = "24612"
PRIORITY = "12460"
VPN_DEVICE = re.compile(r"^(?:mqvpn|tun|gt-tun|gt-udp-tun|dsvpn|wg)[A-Za-z0-9_.-]*$")


def output(*args):
    return subprocess.check_output(args, text=True, stderr=subprocess.DEVNULL)


def apply(args, dry_run):
    if dry_run:
        print(shlex.join(args))
    else:
        subprocess.run(args, check=True)


def lan_access_enabled():
    if not STATE.exists():
        return False
    if STATE.read_text().strip() != "allow":
        raise ValueError(f"invalid WireGuard LAN access state in {STATE}")
    return True


def set_lan_access(enabled):
    STATE.parent.mkdir(parents=True, exist_ok=True)
    if not enabled:
        STATE.unlink(missing_ok=True)
        return
    fd, name = tempfile.mkstemp(prefix=".wg-remote-lan-", dir=STATE.parent)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w") as stream:
            stream.write("allow\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(name, STATE)
    finally:
        if os.path.exists(name):
            os.unlink(name)


def nft_script(remote, networks):
    lines = [
        "flush set inet omr wg_remote_gui_v4",
        "flush set inet omr wg_remote_lan_v4",
    ]
    if remote is not None:
        lines.append(f"add element inet omr wg_remote_gui_v4 {{ {remote} }}")
    if networks:
        collapsed = ipaddress.collapse_addresses(networks)
        elements = ", ".join(str(net) for net in collapsed)
        lines.append(f"add element inet omr wg_remote_lan_v4 {{ {elements} }}")
    return "\n".join(lines) + "\n"


def sync_nft(remote, networks):
    # nft -f submits the flush/add commands as one transaction. A failure is
    # visible to the service and cannot leave one set updated without the other.
    subprocess.run(["nft", "-f", "-"], input=nft_script(remote, networks),
                   text=True, check=True)


def configured_lan(config_path):
    data = json.loads(config_path.read_text())
    users = data.get("users", [{}])
    router = users[0].get("openmptcprouter", {}) if users else {}
    remote_value = router.get("vpnremoteip")
    if remote_value is not None and not isinstance(remote_value, str):
        raise ValueError("router tunnel address must be an IPv4 string")
    remote = None
    if remote_value and remote_value.strip():
        remote = ipaddress.IPv4Address(remote_value)
        if not remote.is_private:
            raise ValueError("router tunnel address must be private IPv4")
    networks = set()
    for raw in router.get("lanips", []):
        net = ipaddress.IPv4Network(raw, strict=False)
        if not net.is_private or net.prefixlen < 16:
            raise ValueError("router LAN prefix is not a narrow private IPv4 network")
        if net.overlaps(ipaddress.IPv4Network("10.255.246.0/24")):
            raise ValueError("router LAN overlaps WireGuard client subnet")
        networks.add(net)
    if remote is None:
        return None, []
    return remote, sorted(networks, key=lambda n: (int(n.network_address), n.prefixlen))


def mqvpn_control(command):
    """Talk only to the local MQVPN control socket with a bounded response."""
    config = json.loads(MQVPN_CONFIG.read_text())
    listen = config.get("control_listen", "127.0.0.1:9090")
    if not isinstance(listen, str):
        raise ValueError("invalid MQVPN control address")
    if listen.startswith("["):
        host, separator, port = listen[1:].partition("]:")
    else:
        host, separator, port = listen.rpartition(":")
    if not separator or not port.isascii() or not port.isdigit() or not 0 < int(port) <= 65535:
        raise ValueError("invalid MQVPN control address")
    if host in ("0.0.0.0", "*", "localhost"):
        host = "127.0.0.1"
    elif host == "::":
        host = "::1"
    if host not in ("127.0.0.1", "::1"):
        raise ValueError("MQVPN control must be reached through loopback")
    with socket.create_connection((host, int(port)), timeout=1.5) as connection:
        connection.sendall((json.dumps(command, separators=(",", ":")) + "\n").encode("utf-8"))
        response = bytearray()
        while b"\n" not in response:
            part = connection.recv(4096)
            if not part or len(response) + len(part) > 16384:
                raise ValueError("invalid MQVPN control response")
            response.extend(part)
    result = json.loads(response.split(b"\n", 1)[0])
    if not isinstance(result, dict) or result.get("ok") is not True:
        raise ValueError("MQVPN control rejected client routes")
    return result


def sync_mqvpn_routes(config_path, require_primary=False):
    """Restore all configured users' LAN routes, regardless of the WG gate."""
    if not MQVPN_CONFIG.exists():
        if require_primary:
            raise ValueError("MQVPN route control is unavailable")
        return
    try:
        users = json.loads(config_path.read_text()).get("users", [{}])[0]
        if not isinstance(users, dict):
            raise ValueError("invalid MQVPN user configuration")
    except (OSError, ValueError, TypeError, KeyError, IndexError) as exc:
        if require_primary:
            raise
        print(f"MQVPN LAN route refresh skipped: {exc}", file=sys.stderr)
        return
    primary_verified = False
    for username, user in users.items():
        if username == "admin" or not isinstance(user, dict) or "userid" not in user:
            continue
        try:
            if not re.fullmatch(r"[A-Za-z0-9_.-]{1,256}", username):
                raise ValueError("invalid MQVPN user name")
            routes = sorted({str(ipaddress.IPv4Network(raw, strict=False))
                             for raw in user.get("lanips", [])})
            reply = mqvpn_control({"cmd": "replace_client_routes", "user": username,
                                   "routes": routes})
            if reply.get("n_routes") != len(routes):
                raise ValueError("MQVPN route count mismatch")
            if require_primary and username == "openmptcprouter":
                status = mqvpn_control({"cmd": "get_client_routes", "user": username})
                if (status.get("user") != username or
                        status.get("routes") != routes or status.get("session_count") != 1):
                    raise ValueError("primary MQVPN LAN route is not ready")
                primary_verified = True
        except (OSError, ValueError, TypeError, json.JSONDecodeError) as exc:
            if require_primary and username == "openmptcprouter":
                raise
            print(f"MQVPN LAN route refresh failed for {username}: {exc}", file=sys.stderr)
    if require_primary and not primary_verified:
        raise ValueError("primary MQVPN user is missing or unverified")


def current_routes():
    # A fresh kernel has no 24612 table; querying it directly exits 2.
    routes = json.loads(output("ip", "-j", "-N", "-4", "route", "show", "table", "all"))
    return {route["dst"] for route in routes if str(route.get("table")) == TABLE}


def rule_present():
    return any(line.lstrip().startswith(PRIORITY + ":") and
               "iif " + WG_INTERFACE in line and "lookup " + TABLE in line
               for line in output("ip", "-4", "rule", "show").splitlines())


def clear_policy_routes():
    for stale in current_routes():
        apply(["ip", "-4", "route", "del", stale, "table", TABLE], False)
    if rule_present():
        apply(["ip", "-4", "rule", "del", "pref", PRIORITY, "iif", WG_INTERFACE,
               "lookup", TABLE], False)


def reconcile(args, enabled):
    interface_up = args.dry_run or Path("/sys/class/net/" + WG_INTERFACE).exists()
    try:
        remote, networks = configured_lan(args.config) if args.config.exists() else (None, [])
    except (ValueError, TypeError, KeyError, AttributeError):
        # Malformed synchronized state must not retain a previously allowed LAN.
        if not args.dry_run and NFT_RULESET.exists():
            sync_nft(None, [])
            clear_policy_routes()
        raise
    allowed_networks = []
    device = ""
    if enabled and interface_up and remote is not None and networks:
        if args.tunnel_dev:
            device = args.tunnel_dev
        else:
            route = json.loads(output("ip", "-j", "-4", "route", "get", str(remote)))
            device = route[0].get("dev", "") if route else ""
        if not VPN_DEVICE.fullmatch(device) or device == WG_INTERFACE:
            if args.tunnel_dev:
                raise ValueError("--tunnel-dev must name an OMR VPN interface")
            device = ""
        else:
            allowed_networks = networks

    if args.lan_access == "allow" and not allowed_networks:
        raise ValueError("OMR LAN or VPN tunnel is unavailable")
    if args.dry_run:
        if not allowed_networks:
            return 0
    elif not NFT_RULESET.exists():
        # The timer may start before nftables during installation; an explicit
        # allow cannot claim success without the firewall gate.
        if args.lan_access == "allow":
            raise ValueError("VPS firewall ruleset is unavailable")
        clear_policy_routes()
        if args.config.exists():
            sync_mqvpn_routes(args.config)
        return 0
    elif not allowed_networks:
        # Revoke before removing routes, including while the VPN is down.
        sync_nft(remote, [])
        clear_policy_routes()
        if args.config.exists():
            sync_mqvpn_routes(args.config)
        return 0

    if not args.dry_run and device.startswith("mqvpn"):
        # MQVPN dispatches by the inner destination. Register and verify the
        # primary user's LAN prefixes before publishing the WG firewall grant.
        sync_mqvpn_routes(args.config, require_primary=True)
    if not args.dry_run:
        for stale in current_routes() - {str(net) for net in networks}:
            apply(["ip", "-4", "route", "del", stale, "table", TABLE], False)
    for net in allowed_networks:
        apply(["ip", "-4", "route", "replace", str(net), "via", str(remote),
               "dev", device, "onlink", "table", TABLE], args.dry_run)
    if args.dry_run or not rule_present():
        apply(["ip", "-4", "rule", "add", "pref", PRIORITY, "iif", WG_INTERFACE,
               "lookup", TABLE], args.dry_run)
    if not args.dry_run:
        # Publish the allowed LANs only after their routes are ready. One nft
        # transaction keeps existing access intact on timer refreshes.
        sync_nft(remote, allowed_networks)
        if not device.startswith("mqvpn"):
            sync_mqvpn_routes(args.config)
    return 0


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--config", type=Path, default=CONFIG)
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--tunnel-dev", help="only for offline dry-run testing")
    parser.add_argument("--lan-access", choices=("allow", "deny", "status"),
                        help="persistent VPS gate for WireGuard client LAN access")
    args = parser.parse_args()
    if args.tunnel_dev and not args.dry_run:
        parser.error("--tunnel-dev requires --dry-run")
    if args.lan_access == "status":
        print("allow" if lan_access_enabled() else "deny")
        return 0
    if args.dry_run:
        enabled = (args.lan_access == "allow" or
                   (args.lan_access != "deny" and lan_access_enabled()))
        return reconcile(args, enabled)

    STATE.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(LOCK, os.O_CREAT | os.O_RDWR, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        enabled = (args.lan_access == "allow" or
                   (args.lan_access != "deny" and lan_access_enabled()))
        try:
            result = reconcile(args, enabled)
            if args.lan_access in ("allow", "deny"):
                set_lan_access(enabled)
            return result
        except Exception:
            # A failed allow or timer refresh must not leave an open gate or
            # a saved allow state. Keep the router GUI separate from LAN access.
            set_lan_access(False)
            try:
                if NFT_RULESET.exists():
                    sync_nft(None, [])
            finally:
                clear_policy_routes()
            raise
    finally:
        fcntl.flock(fd, fcntl.LOCK_UN)
        os.close(fd)


if __name__ == "__main__":
    raise SystemExit(main())